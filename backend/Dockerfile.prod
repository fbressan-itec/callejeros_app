# Imagen de producción del back (la usa Render). Para desarrollo está `Dockerfile`.
# Diferencias: sin herramientas de test, con los estáticos ya preparados y con
# gunicorn en lugar de runserver.
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /usr/local/bin/uv

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Solo las dependencias de producción (sin pytest, ruff ni factory-boy).
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --no-install-project --no-dev

COPY . .

# Estilos del admin y de Swagger en staticfiles/. La clave es solo para poder cargar
# la configuración durante el armado: no se usa para firmar nada.
RUN DJANGO_SECRET_KEY=solo-para-collectstatic python manage.py collectstatic --noinput

# Render indica el puerto en $PORT.
EXPOSE 8000
CMD ["sh", "start.sh"]
