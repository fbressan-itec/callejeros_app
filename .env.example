# Variables de entorno del proyecto.
# Copiá este archivo como .env y completá los valores reales.
# El archivo .env NUNCA se sube al repositorio.
# Cada variable nueva se agrega acá con un valor de ejemplo falso.

# --- Backend (Django) ---
# Clave para firmar sesiones y tokens. En tu .env poné una larga y aleatoria:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
# True solo en desarrollo: muestra los errores con detalle.
DJANGO_DEBUG=True
# Direcciones desde las que se puede usar el back, separadas por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Páginas que pueden llamar a la API desde el navegador (el front), separadas por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Base de datos (opcional). Si no se define, usa SQLite en backend/db.sqlite3.
# Ejemplo para PostgreSQL en un deploy:
# DATABASE_URL=postgres://usuario:clave@servidor:5432/callejeros

# --- Frontend (Next.js) ---
# URL base de la API del back. Lleva el prefijo NEXT_PUBLIC_ porque la usa el navegador:
# nunca pongas secretos en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
